        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "title": "Id",
            "type": "string"
          },
          "duration_ms": {
            "default": 800,
            "maximum": 120000,
            "minimum": 50,
            "title": "Duration Ms",
            "type": "integer"
          },
          "start": {
            "anyOf": [
              {
                "$ref": "#/$defs/Anchor"
              },
              {
                "type": "null"
