              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "region": {
            "default": "auto",
            "enum": [
              "auto",
              "title",
              "left",
              "center",
              "right",
              "top",
              "bottom",
              "full"
